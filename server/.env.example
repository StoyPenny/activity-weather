# Server Configuration
PORT=3001

# Restrict CORS to the frontend origin in production (leave unset to allow all origins in dev)
# CORS_ORIGIN=http://localhost:5173

# Stormglass API Key (moved from frontend for security)
STORMGLASS_API_KEY=your_api_key_here

# Database path (relative to server directory)
DB_PATH=./data/activity-weather.sqlite
